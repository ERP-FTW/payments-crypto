<odoo>
    <data>
        <record id="transaction_form_crypto" model="ir.ui.view">
            <field name="name">transaction.form.crypto</field>
            <field name="model">payment.transaction</field>
            <field name="inherit_id" ref="payment.payment_transaction_form" />
            <field name="arch" type="xml">
                <group name="transaction_details" position="after">
                    <group name="crypto_payment_details" string="Crypto Details">
                        <field name="crypto_currency_id" />
                        <field name="crypto_amount" />
                        <field name="crypto_rate" />
                        <field name="provider_invoice_id" />
                        <field name="provider_payment_id" />
                        <field name="provider_payout_id" />
                        <field name="crypto_payment_link" style="width:50px" />
                        <field name="account_payment_id" />
                        <field name="account_payment_state" readonly="1" />
                    </group>
                </group>
            </field>
        </record>
    </data>
</odoo>
