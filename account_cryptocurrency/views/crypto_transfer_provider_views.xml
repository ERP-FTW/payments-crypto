<odoo>
    <record id="view_crypto_transfer_provider_tree" model="ir.ui.view">
        <field name="name">crypto.transfer.provider.tree</field>
        <field name="model">crypto.transfer.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="environment"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_crypto_transfer_provider_form" model="ir.ui.view">
        <field name="name">crypto.transfer.provider.form</field>
        <field name="model">crypto.transfer.provider</field>
        <field name="arch" type="xml">
            <form string="Crypto Transfer Provider">
                <header>
                    <button
                        name="action_test_connection"
                        type="object"
                        string="Test Connection"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="company_id"/>
                            <field name="environment"/>
                            <field name="provider_uuid" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="notes" placeholder="Notes / credentials placeholders"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crypto_transfer_provider" model="ir.actions.act_window">
        <field name="name">Crypto Transfer Providers</field>
        <field name="res_model">crypto.transfer.provider</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
