<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_currency_move_search" model="ir.ui.view">
        <field name="name">res.currency.move.search</field>
        <field name="model">res.currency.move</field>
        <field name="arch" type="xml">
            <search string="Currency Moves">
                <field name="name" />
                <field name="payment_id" />
                <field name="direction" />
                <field name="currency_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="state" />
                <field name="date" />
            </search>
        </field>
    </record>

    <record id="view_currency_move_list" model="ir.ui.view">
        <field name="name">res.currency.move.list</field>
        <field name="model">res.currency.move</field>
        <field name="arch" type="xml">
            <list
                decoration-info="state == 'draft'"
                decoration-muted="state == 'cancel'"
            >
                <field name="name" />
                <field name="date" />
                <field name="payment_id" />
                <field name="direction" />
                <field name="currency_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="amount" widget="monetary" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="view_currency_move_form" model="ir.ui.view">
        <field name="name">res.currency.move.form</field>
        <field name="model">res.currency.move</field>
        <field name="arch" type="xml">
            <form string="Currency Move">
                <header>
                    <button
                        name="action_post"
                        string="Post"
                        type="object"
                        invisible="state != 'draft'"
                        class="oe_highlight"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state != 'posted'"
                    />
                    <button
                        name="action_draft"
                        string="Draft"
                        type="object"
                        invisible="state != 'cancel'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,posted,cancel"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="payment_id" />
                            <field name="currency_id" />
                            <field name="date" />
                            <field name="direction" />
                            <field name="amount" widget="monetary" />
                            <field name="journal_id" />
                            <field name="debit_account_id" />
                            <field name="credit_account_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group>

                        </group>
                    </group>
                    <notebook>
                        <page name="move_lines" string="Move Lines">
                            <group>
                                <field name="line_ids" nolabel="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_currency_move_form" model="ir.actions.act_window">
        <field name="name">Currency Moves</field>
        <field name="res_model">res.currency.move</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_currency_move_search" />
    </record>

    <menuitem
        action="action_currency_move_form"
        id="menu_action_currency_move"
        parent="menu_currency_moves"
        sequence="10"
    />

</odoo>
