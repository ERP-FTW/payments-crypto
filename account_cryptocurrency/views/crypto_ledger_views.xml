<odoo>
  <record id="view_crypto_asset_list" model="ir.ui.view"><field name="name">crypto.asset.list</field><field name="model">crypto.asset</field><field name="arch" type="xml"><list><field name="name"/><field name="symbol"/><field name="network_code"/><field name="contract_address"/><field name="decimal_places"/><field name="active"/></list></field></record>
  <record id="view_crypto_asset_form" model="ir.ui.view"><field name="name">crypto.asset.form</field><field name="model">crypto.asset</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="symbol"/><field name="network_code"/><field name="contract_address" invisible="is_native_asset"/><field name="is_native_asset"/><field name="decimal_places"/><field name="res_currency_id"/><field name="notes"/></group></sheet></form></field></record>
  <record id="action_crypto_asset" model="ir.actions.act_window"><field name="name">Crypto Assets</field><field name="res_model">crypto.asset</field><field name="view_mode">list,form</field></record>
  <record id="view_crypto_event_list" model="ir.ui.view"><field name="name">crypto.provider.event.list</field><field name="model">crypto.provider.event</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="received_at"/><field name="company_id"/><field name="provider_id"/><field name="event_type"/><field name="provider_object_id"/><field name="payload_hash"/><field name="signature_verified"/><field name="processing_state"/><field name="settlement_id"/></list></field></record>
  <record id="action_crypto_event" model="ir.actions.act_window"><field name="name">Provider Events</field><field name="res_model">crypto.provider.event</field><field name="view_mode">list,form</field></record>
  <record id="view_crypto_snapshot_list" model="ir.ui.view"><field name="name">crypto.rate.snapshot.list</field><field name="model">crypto.rate.snapshot</field><field name="arch" type="xml"><list><field name="quoted_at"/><field name="company_id"/><field name="crypto_asset_id"/><field name="base_currency_id"/><field name="purpose"/><field name="source_pair"/><field name="rate_base_per_crypto"/><field name="state"/></list></field></record>
  <record id="action_crypto_snapshot" model="ir.actions.act_window"><field name="name">Rate Snapshots</field><field name="res_model">crypto.rate.snapshot</field><field name="view_mode">list,form</field></record>
  <record id="view_crypto_settlement_list" model="ir.ui.view"><field name="name">crypto.settlement.list</field><field name="model">crypto.settlement</field><field name="arch" type="xml"><list create="0"><field name="confirmed_at"/><field name="company_id"/><field name="direction"/><field name="settlement_kind"/><field name="provider_id"/><field name="crypto_asset_id"/><field name="atomic_amount"/><field name="provider_transfer_id"/><field name="state"/><field name="account_move_id"/></list></field></record>
  <record id="action_crypto_settlement" model="ir.actions.act_window"><field name="name">Settlements</field><field name="res_model">crypto.settlement</field><field name="view_mode">list,form</field></record>
</odoo>
