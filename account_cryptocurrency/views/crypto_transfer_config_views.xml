<odoo>
    <record id="view_crypto_transfer_config_tree" model="ir.ui.view">
        <field name="name">crypto.transfer.config.tree</field>
        <field name="model">crypto.transfer.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="crypto_currency_id"/>
                <field name="crypto_asset_id"/>
                <field name="provider_id"/>
                <field name="crypto_journal_id"/>
                <field name="priority"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_crypto_transfer_config_form" model="ir.ui.view">
        <field name="name">crypto.transfer.config.form</field>
        <field name="model">crypto.transfer.config</field>
        <field name="arch" type="xml">
            <form string="Crypto Transfer Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="crypto_currency_id"/>
                            <field name="crypto_asset_id"/>
                            <field name="provider_id" domain="[('company_id', '=', company_id)]"/>
                            <field
                                name="crypto_journal_id"
                                domain="[('type', 'in', ('bank', 'cash')), ('currency_id', '=', crypto_currency_id), ('company_id', '=', company_id)]"
                            />
                            <field name="transfer_partner_id"/>
                            <field name="priority"/>
                            <field name="active"/>
                        </group>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crypto_transfer_config" model="ir.actions.act_window">
        <field name="name">Crypto Transfer Configurations</field>
        <field name="res_model">crypto.transfer.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
