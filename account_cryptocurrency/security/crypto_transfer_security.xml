<odoo>
  <record id="module_category_crypto_transfer" model="ir.module.category"><field name="name">Crypto Transfers</field><field name="sequence">35</field></record>
  <record id="group_crypto_transfer_viewer" model="res.groups"><field name="name">Crypto Transfer Viewer</field><field name="category_id" ref="module_category_crypto_transfer"/></record>
  <record id="group_crypto_transfer_operator" model="res.groups"><field name="name">Crypto Transfer Operator</field><field name="category_id" ref="module_category_crypto_transfer"/><field name="implied_ids" eval="[(4, ref('group_crypto_transfer_viewer'))]"/></record>
  <record id="group_crypto_transfer_accountant" model="res.groups"><field name="name">Crypto Transfer Accountant</field><field name="category_id" ref="module_category_crypto_transfer"/><field name="implied_ids" eval="[(4, ref('group_crypto_transfer_viewer'))]"/></record>
  <record id="group_crypto_transfer_admin" model="res.groups"><field name="name">Crypto Transfer Administrator</field><field name="category_id" ref="module_category_crypto_transfer"/><field name="implied_ids" eval="[(4, ref('group_crypto_transfer_operator')), (4, ref('group_crypto_transfer_accountant'))]"/></record>

  <record id="rule_provider_company" model="ir.rule"><field name="name">Transfer provider companies</field><field name="model_id" ref="model_crypto_transfer_provider"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_crypto_transfer_viewer'))]"/></record>
  <record id="rule_config_company" model="ir.rule"><field name="name">Transfer configuration companies</field><field name="model_id" ref="model_crypto_transfer_config"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_crypto_transfer_viewer'))]"/></record>
  <record id="rule_transfer_company" model="ir.rule"><field name="name">Transfer companies</field><field name="model_id" ref="model_crypto_transfer"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_crypto_transfer_viewer'))]"/></record>
  <record id="rule_line_company" model="ir.rule"><field name="name">Transfer line companies</field><field name="model_id" ref="model_crypto_transfer_line"/><field name="domain_force">[('transfer_id.company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_crypto_transfer_viewer'))]"/></record>
  <record id="rule_event_company" model="ir.rule"><field name="name">Provider event companies</field><field name="model_id" ref="model_crypto_provider_event"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_crypto_transfer_viewer'))]"/></record>
  <record id="rule_settlement_company" model="ir.rule"><field name="name">Settlement companies</field><field name="model_id" ref="model_crypto_settlement"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_crypto_transfer_viewer'))]"/></record>
  <record id="rule_snapshot_company" model="ir.rule"><field name="name">Rate snapshot companies</field><field name="model_id" ref="model_crypto_rate_snapshot"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_crypto_transfer_viewer'))]"/></record>
</odoo>
