<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="PaymentScreenPaymentLines" t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension" owl="1">
        <!--
            Odoo 18 changed the paymentline wrapper from:
                <div class="paymentline electronic_payment">
            to:
                <div t-attf-class="... paymentline electronic_payment">
            in commit 02b38b8bd9bd2aa3bfc3ac30e29c3de0083bff48.

            Do not use hasclass() here because it only checks a literal class=""
            attribute and fails when the class is provided through t-attf-class.
            Match either representation so the extension works across older and
            newer Odoo 18.0 builds.
        -->
        <xpath expr="//t[@t-if='line and line.payment_status']/div[contains(concat(' ', normalize-space(@class), ' '), ' electronic_payment ') or contains(concat(' ', normalize-space(@t-attf-class), ' '), ' electronic_payment ')][1]" position="inside">
            <t t-elif="line.payment_status == 'cryptowaiting'">
                <div class="electronic_status">
                    <t t-esc="line.crypto_payment_status"/>
                </div>
                <div class="button show_receipt highlight" title="Show receipt" t-on-click="() => this.pos.clickShowReceipt()">
                    Show receipt
                </div>
            </t>
        </xpath>
    </t>
</templates>
