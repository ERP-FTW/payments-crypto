<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="mlr_pos_cryptopayments.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('before-footer')]" position="after">
            <t t-foreach="paymentLines" t-as="line" t-key="line.uuid">
                <div t-if="line.cryptopay_payment_link_qr_code" class="mt-3 text-center">
                    <div>----------------------------</div>
                    <div class="pos-receipt-title">Scan QR to pay with cryptocurrency</div>
                    <img
                        id="cryptopay-qrcode"
                        t-att-src="line.cryptopay_payment_link_qr_code"
                        width="300"
                        alt="Cryptocurrency payment QR code"
                    />
                    <div>
                        Conversion rate ($/crypto):
                        <span t-esc="line.conversion_rate" class="pos-receipt-right-align"/>
                    </div>
                    <div>
                        Invoiced Crypto:
                        <span t-esc="line.invoiced_crypto_amount" class="pos-receipt-right-align"/>
                    </div>
                    <div class="pos-receipt-title">Powered by MI Lightning Rod</div>
                    <div class="pos-receipt-title">www.MILightningRod.com</div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
