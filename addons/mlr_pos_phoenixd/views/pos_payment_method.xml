<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_phoenixd" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.phoenixd</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <group name="phoenixd_payment" string="Phoenixd" colspan="4" invisible="use_payment_terminal != 'phoenixd'">
                    <field name="phoenixd_base_url" required="use_payment_terminal == 'phoenixd'"/>
                    <field name="phoenixd_http_password" password="True" required="use_payment_terminal == 'phoenixd'"/>
                    <field name="phoenixd_payment_type" required="use_payment_terminal == 'phoenixd'"/>
                    <field name="phoenixd_usd_per_btc_rate" required="use_payment_terminal == 'phoenixd'"/>
                    <field name="phoenixd_fiat_currency_id" required="use_payment_terminal == 'phoenixd'"/>
                    <field name="phoenixd_crypto_currency_id" required="use_payment_terminal == 'phoenixd'"/>
                    <div colspan="2" class="mt16">
                        <button name="action_phoenixd_get_balance" type="object" string="Get Phoenixd Balance" class="oe_highlight"/>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
