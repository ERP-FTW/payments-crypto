<?xml version="1.0" ?>
<odoo>
    <record id="payment_provider_now" model="payment.provider">
        <field name="name">now</field>
        <field name="code">now</field>
        <field name="is_crypto_provider">true</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="image_128" type="base64" file="mlr_ecommerce_nowpayments/static/description/icon.png"/>
        <!-- <field name="display_as">Now Payments powered by MI Lightning Rod</field> -->
        <!-- <field name="inline_form_view_id" ref="now_inline_form"/> -->
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="payment_method_ids"
           eval="[Command.set([ref('payment_method_nowpayments')])]"/>
    </record>
</odoo>
