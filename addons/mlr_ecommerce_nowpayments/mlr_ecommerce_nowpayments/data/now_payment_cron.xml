<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Completes NOWPayments transactions whose notification was missed and whose buyer never
         came back to the store. It reads each open transaction's own invoice from the provider. -->
    <record model="ir.cron" id="cron_nowpayments_reconcile">
        <field name="name">NOWPayments: reconcile open transactions</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_nowpayments_reconcile()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
