<odoo>
  <record id="redirect_form" model="ir.ui.view">
    <field name="name">nowpayments.redirect.form</field>
    <field name="type">qweb</field>
    <field name="key">mlr_ecommerce_nowpayments.redirect_form</field>
    <field name="arch" type="xml">
      <!-- Only the reference is posted: the server reads amount and currency from the transaction. -->
      <form t-att-action="api_url" method="post">
        <input type="hidden" name="reference" t-att-value="reference"/>
      </form>
    </field>
  </record>
</odoo>
