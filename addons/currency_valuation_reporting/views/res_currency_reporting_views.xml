<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_currency_inventory_report_search" model="ir.ui.view">
        <field name="name">res.currency.inventory.report.search</field>
        <field name="model">res.currency.inventory.report</field>
        <field name="arch" type="xml">
            <search string="Currency Inventory">
                <field name="currency_id" />
                <field name="company_id" groups="base.group_multi_company" />
            </search>
        </field>
    </record>

    <record id="view_currency_inventory_report_list" model="ir.ui.view">
        <field name="name">res.currency.inventory.report.list</field>
        <field name="model">res.currency.inventory.report</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="currency_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="qty_in" sum="Total In" />
                <field name="qty_out" sum="Total Out" />
                <field name="remaining_qty" sum="Remaining" />
                <field name="company_currency_id" invisible="1" />
                <field
                    name="inbound_value"
                    widget="monetary"
                    options="{'currency_field': 'company_currency_id'}"
                    sum="Inbound Value"
                />
                <field
                    name="outbound_cost_value"
                    widget="monetary"
                    options="{'currency_field': 'company_currency_id'}"
                    sum="Outbound Cost"
                />
                <field
                    name="inventory_value"
                    widget="monetary"
                    options="{'currency_field': 'company_currency_id'}"
                    sum="Inventory Value"
                />
            </list>
        </field>
    </record>

    <record id="view_currency_inventory_report_pivot" model="ir.ui.view">
        <field name="name">res.currency.inventory.report.pivot</field>
        <field name="model">res.currency.inventory.report</field>
        <field name="arch" type="xml">
            <pivot string="Currency Inventory" disable_linking="true">
                <field name="currency_id" type="row" />
                <field name="company_id" type="col" groups="base.group_multi_company" />
                <field name="qty_in" type="measure" />
                <field name="qty_out" type="measure" />
                <field name="remaining_qty" type="measure" />
                <field name="inbound_value" type="measure" />
                <field name="outbound_cost_value" type="measure" />
                <field name="inventory_value" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="action_currency_inventory_report" model="ir.actions.act_window">
        <field name="name">Inventory Position</field>
        <field name="res_model">res.currency.inventory.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_currency_inventory_report_search" />
    </record>

    <record id="view_currency_gain_loss_report_search" model="ir.ui.view">
        <field name="name">res.currency.gain.loss.report.search</field>
        <field name="model">res.currency.gain.loss.report</field>
        <field name="arch" type="xml">
            <search string="Currency Gain/Loss">
                <field name="currency_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="payment_id" />
                <field name="partner_id" />
                <field name="payment_date" />
                <field name="disposal_date" />
                <filter name="group_currency" string="Currency" context="{'group_by': 'currency_id'}" />
                <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}" />
                <filter name="group_disposal_date" string="Disposal Date" context="{'group_by': 'disposal_date'}" />
            </search>
        </field>
    </record>

    <record id="view_currency_gain_loss_report_list" model="ir.ui.view">
        <field name="name">res.currency.gain.loss.report.list</field>
        <field name="model">res.currency.gain.loss.report</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="disposal_date" />
                <field name="currency_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="payment_id" optional="show" />
                <field name="partner_id" optional="show" />
                <field name="payment_ref" optional="hide" />
                <field name="quantity" sum="Disposed Qty" />
                <field name="company_currency_id" invisible="1" />
                <field
                    name="cost_basis"
                    widget="monetary"
                    options="{'currency_field': 'company_currency_id'}"
                    sum="Cost Basis"
                />
                <field
                    name="proceeds"
                    widget="monetary"
                    options="{'currency_field': 'company_currency_id'}"
                    sum="Proceeds"
                />
                <field
                    name="gain_loss"
                    widget="monetary"
                    options="{'currency_field': 'company_currency_id'}"
                    sum="Gain/Loss"
                />
            </list>
        </field>
    </record>

    <record id="view_currency_gain_loss_report_pivot" model="ir.ui.view">
        <field name="name">res.currency.gain.loss.report.pivot</field>
        <field name="model">res.currency.gain.loss.report</field>
        <field name="arch" type="xml">
            <pivot string="Currency Gain/Loss" disable_linking="true">
                <field name="currency_id" type="row" />
                <field name="partner_id" type="row" />
                <field name="disposal_date" type="col" interval="month" />
                <field name="quantity" type="measure" />
                <field name="cost_basis" type="measure" />
                <field name="proceeds" type="measure" />
                <field name="gain_loss" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="view_currency_gain_loss_report_graph" model="ir.ui.view">
        <field name="name">res.currency.gain.loss.report.graph</field>
        <field name="model">res.currency.gain.loss.report</field>
        <field name="arch" type="xml">
            <graph string="Currency Gain/Loss" type="bar" disable_linking="true">
                <field name="disposal_date" type="row" interval="month" />
                <field name="gain_loss" type="measure" />
                <field name="currency_id" type="col" />
            </graph>
        </field>
    </record>

    <record id="action_currency_gain_loss_report" model="ir.actions.act_window">
        <field name="name">Realized Gain/Loss</field>
        <field name="res_model">res.currency.gain.loss.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_currency_gain_loss_report_search" />
    </record>

    <record id="view_currency_reconciliation_report_search" model="ir.ui.view">
        <field name="name">res.currency.reconciliation.report.search</field>
        <field name="model">res.currency.reconciliation.report</field>
        <field name="arch" type="xml">
            <search string="Currency Reconciliation">
                <field name="payment_id" />
                <field name="currency_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="partner_id" />
                <field name="payment_date" />
                <filter name="group_currency" string="Currency" context="{'group_by': 'currency_id'}" />
                <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}" />
                <filter name="group_payment_date" string="Payment Date" context="{'group_by': 'payment_date'}" />
            </search>
        </field>
    </record>

    <record id="view_currency_reconciliation_report_list" model="ir.ui.view">
        <field name="name">res.currency.reconciliation.report.list</field>
        <field name="model">res.currency.reconciliation.report</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="payment_date" />
                <field name="payment_id" />
                <field name="state" />
                <field name="currency_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="partner_id" optional="show" />
                <field name="payment_type" />
                <field name="payment_amount_currency" sum="Payment Amount" />
                <field name="crypto_received_qty" sum="Received Qty" />
                <field name="crypto_sent_qty" sum="Sent Qty" />
                <field name="company_currency_id" invisible="1" />
                <field
                    name="inbound_value"
                    widget="monetary"
                    options="{'currency_field': 'company_currency_id'}"
                    sum="Inbound Value"
                />
                <field
                    name="outbound_cost_value"
                    widget="monetary"
                    options="{'currency_field': 'company_currency_id'}"
                    sum="Outbound Cost"
                />
                <field
                    name="payment_value_company_currency"
                    widget="monetary"
                    options="{'currency_field': 'company_currency_id'}"
                    sum="Payment Value"
                />
                <field
                    name="disposal_gain_loss"
                    widget="monetary"
                    options="{'currency_field': 'company_currency_id'}"
                    sum="Gain/Loss"
                />
            </list>
        </field>
    </record>

    <record id="view_currency_reconciliation_report_pivot" model="ir.ui.view">
        <field name="name">res.currency.reconciliation.report.pivot</field>
        <field name="model">res.currency.reconciliation.report</field>
        <field name="arch" type="xml">
            <pivot string="Currency Reconciliation" disable_linking="true">
                <field name="currency_id" type="row" />
                <field name="payment_date" type="col" interval="month" />
                <field name="payment_amount_currency" type="measure" />
                <field name="crypto_received_qty" type="measure" />
                <field name="crypto_sent_qty" type="measure" />
                <field name="inbound_value" type="measure" />
                <field name="outbound_cost_value" type="measure" />
                <field name="payment_value_company_currency" type="measure" />
                <field name="disposal_gain_loss" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="action_currency_reconciliation_report" model="ir.actions.act_window">
        <field name="name">Payment Reconciliation</field>
        <field name="res_model">res.currency.reconciliation.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_currency_reconciliation_report_search" />
    </record>

    <menuitem
        id="menu_currency_reporting"
        name="Reporting"
        parent="account_cryptocurrency.menu_currency_moves"
        sequence="40"
        groups="account.group_account_user,account.group_account_manager,account.group_account_invoice"
    />

    <menuitem
        id="menu_currency_inventory_report"
        name="Inventory Position"
        parent="menu_currency_reporting"
        action="action_currency_inventory_report"
        sequence="10"
    />

    <menuitem
        id="menu_currency_gain_loss_report"
        name="Realized Gain/Loss"
        parent="menu_currency_reporting"
        action="action_currency_gain_loss_report"
        sequence="20"
    />

    <menuitem
        id="menu_currency_reconciliation_report"
        name="Payment Reconciliation"
        parent="menu_currency_reporting"
        action="action_currency_reconciliation_report"
        sequence="30"
    />

</odoo>
