<odoo>
    <record id="view_crypto_transfer_provider_form_nowpayments" model="ir.ui.view">
        <field name="name">crypto.transfer.provider.form.nowpayments</field>
        <field name="model">crypto.transfer.provider</field>
        <field name="inherit_id" ref="account_cryptocurrency.view_crypto_transfer_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="NOWPayments" invisible="code != 'nowpayments_crypto_payout'">
                    <group>
                        <field name="nowpayments_api_base_url"/>
                        <field name="credential_source"/>
                        <field name="nowpayments_api_key" password="True"/>
                        <field name="api_key_env_var" invisible="credential_source != 'environment'"/>
                        <field name="ipn_secret" password="True"/>
                        <field name="ipn_secret_env_var" invisible="credential_source != 'environment'"/>
                        <field name="nowpayments_email"/>
                        <field name="nowpayments_password" password="True"/>
                        <field name="nowpayments_timeout"/>
                    </group>
                    <group>
                        <field name="nowpayments_jwt_token" password="True"/>
                        <field name="nowpayments_token_updated_at" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
