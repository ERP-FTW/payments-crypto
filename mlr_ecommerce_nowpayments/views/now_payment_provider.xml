<odoo>
    <data>
        <record id="provider_form_now" model="ir.ui.view">
            <field name="name">provider.form.now</field>
            <field name="model">payment.provider</field>
            <field name="inherit_id" ref="payment.payment_provider_form"/>
            <field name="arch" type="xml">
                <group name="provider_credentials" position="inside">
                    <group name="provider_credentials" position="before">
                        <div invisible="code != 'now'">
                        <label string="NowPayments Settings" class="o_form_label"/>
                        <div class="o_row">
                        <field name="nowpayments_username" password="True"/>
                        <field name="nowpayments_password" password="True"/>
                        </div>
                    <button string="Connect Now Server"
                type="object"
                name="action_test_connection"
                class="btn-primary"
                colspan="2"
                icon="fa-television"
                invisible="state == 'enabled'"/>
                        </div>
                    </group>

                </group>
            </field>
        </record>
    </data>
</odoo>
