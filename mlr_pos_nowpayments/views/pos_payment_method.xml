<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_now" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.now</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <group name="crypto_payment" colspan="4">
                    <field name="server_url" invisible="use_payment_terminal != 'now'" required="use_payment_terminal == 'now'"/>
                    <field name="api_key" invisible="use_payment_terminal != 'now'" required="use_payment_terminal == 'now'" password="True"/>
                    <field name="now_payment_flow" invisible="use_payment_terminal != 'now'" required="use_payment_terminal == 'now'"/>
                    <field name="nowpayments_username" invisible="use_payment_terminal != 'now'" required="use_payment_terminal == 'now'" password="True"/>
                    <field name="nowpayments_password" invisible="use_payment_terminal != 'now'" required="use_payment_terminal == 'now'" password="True"/>
                    <field name="crypto_minimum_amount" invisible="use_payment_terminal != 'now'" required="use_payment_terminal == 'now'"/>
                    <field name="crypto_maximum_amount" invisible="use_payment_terminal != 'now'" required="use_payment_terminal == 'now'"/>
                    <field name="now_selected_crypto" invisible="use_payment_terminal != 'now' or now_payment_flow != 'direct invoice'" required="use_payment_terminal == 'now' and now_payment_flow == 'direct invoice'"/>
                    <field name="now_sandbox" invisible="use_payment_terminal != 'now' or now_payment_flow != 'direct invoice'"/>
                    <field name="now_sandbox_case" invisible="use_payment_terminal != 'now' or now_payment_flow != 'direct invoice'" required="now_sandbox"/>
                    <div colspan="2" class="mt16" invisible="use_payment_terminal != 'now'">
                        <button name="action_test_connection" type="object" string="Test CryptoPay Server connection" class="oe_highlight"/>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
