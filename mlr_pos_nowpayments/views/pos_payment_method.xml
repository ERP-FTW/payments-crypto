<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_now" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.now</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <group name="crypto_payment" colspan="4">
                    <field name="server_url" attrs="{'invisible': [('use_payment_terminal', '!=', 'now')], 'required': [('use_payment_terminal', '=', 'now')]}"/>
                    <field name="api_key" attrs="{'invisible': [('use_payment_terminal', '!=', 'now')], 'required': [('use_payment_terminal', '=', 'now')]}" password="True"/>
                    <field name="now_payment_flow" attrs="{'invisible': [('use_payment_terminal', '!=', 'now')], 'required': [('use_payment_terminal', '=', 'now')]}"/>
                    <field name="nowpayments_username" attrs="{'invisible': [('use_payment_terminal', '!=', 'now')], 'required': [('use_payment_terminal', '=', 'now')]}" password="True"/>
                    <field name="nowpayments_password" attrs="{'invisible': [('use_payment_terminal', '!=', 'now')], 'required': [('use_payment_terminal', '=', 'now')]}" password="True"/>
                    <field name="crypto_minimum_amount" attrs="{'invisible': [('use_payment_terminal', '!=', 'now')], 'required': [('use_payment_terminal', '=', 'now')]}"/>
                    <field name="crypto_maximum_amount" attrs="{'invisible': [('use_payment_terminal', '!=', 'now')], 'required': [('use_payment_terminal', '=', 'now')]}"/>
                    <field name="now_selected_crypto" attrs="{'invisible': ['|',('use_payment_terminal', '!=', 'now'),('now_payment_flow', '!=', 'direct invoice')], 'required': [('now_payment_flow', '=', 'direct invoice')]}"/>
                    <field name="now_sandbox" attrs="{'invisible': ['|',('use_payment_terminal', '!=', 'now'),('now_payment_flow', '!=', 'direct invoice')]}"/>
                    <field name="now_sandbox_case" attrs="{'invisible': ['|',('use_payment_terminal', '!=', 'now'),('now_payment_flow', '!=', 'direct invoice')], 'required': [('now_sandbox', '=', True)]}"/>
                    <div colspan="2" class="mt16" attrs="{'invisible': [('use_payment_terminal', '!=', 'now')], 'required': [('use_payment_terminal', '=', 'now')]}">
                    <button name="action_test_connection" type="object" string="Test CryptoPay Server connection" class="oe_highlight"/>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
