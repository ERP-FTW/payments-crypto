<odoo>
    <record id="view_crypto_cashout_config_tree" model="ir.ui.view">
        <field name="name">crypto.cashout.config.tree</field>
        <field name="model">crypto.cashout.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="crypto_currency_id"/>
                <field name="cashout_provider_id"/>
                <field name="crypto_journal_id"/>
                <field name="priority"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_crypto_cashout_config_form" model="ir.ui.view">
        <field name="name">crypto.cashout.config.form</field>
        <field name="model">crypto.cashout.config</field>
        <field name="arch" type="xml">
            <form string="Cashout Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="crypto_currency_id"/>
                            <field name="cashout_provider_id" domain="[('company_id', '=', company_id)]"/>
                            <field
                                name="crypto_journal_id"
                                domain="[('type', 'in', ('bank', 'cash')), ('currency_id', '=', crypto_currency_id), ('company_id', '=', company_id)]"
                            />
                            <field name="cashout_partner_id"/>
                            <field name="priority"/>
                            <field name="active"/>
                        </group>
                        <group string="Fiat Settlement (TODO)">
                            <field name="fiat_currency_id"/>
                            <field name="bank_journal_id"/>
                            <field name="clearing_account_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crypto_cashout_config" model="ir.actions.act_window">
        <field name="name">Cashout Configurations</field>
        <field name="res_model">crypto.cashout.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
